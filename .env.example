# Must be a direct PostgreSQL connection string (lib/prisma.ts uses @prisma/adapter-pg, not Prisma Accelerate).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Seeding resets reviewed status and re-grants the seed admin. ATLAS_ALLOW_SEED in an env file the
# repository loads is ignored (lib/load-env.ts); it works only inline on the command line. This does
# not cover a file you load yourself, e.g. `node --env-file` or a `dotenv/config` preload:
#   ATLAS_ALLOW_SEED=1 pnpm db:seed   (local disposable database only)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Network graph source mode: auto, file, database, or hybrid.
NETWORK_GRAPH_SOURCE="auto"
NETWORK_GRAPH_IMPORT_FILE_PATH="data/imports/thailand_humanoid_atlas_seed_records.json"

# Protects /admin, /data-pulls, and /api/ingest/* in production.
ADMIN_BASIC_USER="creativelab.co.th@gmail.com"
ADMIN_BASIC_PASSWORD="change-this-before-deploy"

# Optional ingestion keys. Leave blank to use public/no-key endpoints where available.
YOUTUBE_API_KEY=""
GITHUB_TOKEN=""
